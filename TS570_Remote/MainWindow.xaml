<Window x:Class="TS570_Remote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fx="clr-namespace:TS570_Remote.Controls"
        mc:Ignorable="d"
        Title="Kenwood TS-570D Remote Control"
        Height="525" Width="1080"
        MinHeight="300" MinWidth="700"
        ResizeMode="CanResize"
        Background="#FF0A0A0D">

    <!--
    DSEG7 Classic (free): https://github.com/keshikan/DSEG
    Embedded font: Resources/Fonts/DSEG7Classic-BoldItalic.ttf  (Build Action = Resource)
    FontFamily: pack://application:,,,/Resources/Fonts/DSEG7Classic-BoldItalic.ttf#DSEG7 Classic
    Key, knob, lamp and legend styles live in Themes/Panel.xaml; menu and dialogs in Themes/Theme.xaml.
    -->

    <Window.Resources>

        <!-- Every front-panel button is a key cap unless it says otherwise. -->
        <Style TargetType="Button" BasedOn="{StaticResource MetalBtn}"/>

        <!-- ══ LCD BADGE: status indicator ══════════════════════════════════ -->
        <!-- Dark amber LCD text appearance -->
        <Style x:Key="LcdBadge" TargetType="Border">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="CornerRadius"  Value="0"/>
            <Setter Property="Padding"       Value="0"/>
            <Setter Property="Margin"        Value="0"/>
            <Setter Property="Opacity"       Value="0.0784"/>
            <Setter Property="Visibility"    Value="Visible"/>
        </Style>
        <Style x:Key="LcdBadgeText" TargetType="TextBlock">
            <Setter Property="FontFamily"   Value="pack://application:,,,/Resources/Fonts/helvetica-bold.ttf#Helvetica"/>
            <Setter Property="FontSize"     Value="13.6"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="Foreground"   Value="#FF180800"/>
        </Style>
        <Style x:Key="LcdBadgeInverted" TargetType="Border" BasedOn="{StaticResource LcdBadge}">
            <Setter Property="Background"   Value="#FF180800"/>
            <Setter Property="CornerRadius" Value="1.8"/>
            <Setter Property="Padding"      Value="5.2,0.4"/>
            <Setter Property="MinWidth"     Value="22"/>
        </Style>
        <Style x:Key="LcdBadgeInvertedDigit" TargetType="Border" BasedOn="{StaticResource LcdBadgeInverted}">
            <Setter Property="Padding"      Value="4.2,0.4"/>
            <Setter Property="MinWidth"     Value="0"/>
        </Style>
        <Style x:Key="LcdBadgeTextInverted" TargetType="TextBlock" BasedOn="{StaticResource LcdBadgeText}">
            <Setter Property="Foreground"   Value="{DynamicResource LcdThemeOnBrush}"/>
            <Setter Property="FontSize"     Value="12.8"/>
        </Style>
        <Style x:Key="LcdBadgeTextTopSmall" TargetType="TextBlock" BasedOn="{StaticResource LcdBadgeText}">
            <Setter Property="FontSize"     Value="10.8"/>
        </Style>
        <Style x:Key="LcdBadgeTextInvertedTopSmall" TargetType="TextBlock" BasedOn="{StaticResource LcdBadgeTextInverted}">
            <Setter Property="FontSize"     Value="10.2"/>
        </Style>
        <SolidColorBrush x:Key="LcdThemeOnBrush" Color="#FFFF9200"/>

        <!-- ══ Concentric-knob legend glyph "—◎—" (outer ring / inner knob) ═ -->
        <ControlTemplate x:Key="ConcentricGlyph" TargetType="ContentControl">
            <StackPanel Orientation="Horizontal" Margin="2.5,0" VerticalAlignment="Center">
                <Rectangle Width="8.5" Height="1.3" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                <Grid Width="9" Height="9">
                    <Ellipse Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3"/>
                    <Ellipse Width="3" Height="3" Fill="{TemplateBinding Foreground}"/>
                </Grid>
                <Rectangle Width="8.5" Height="1.3" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
            </StackPanel>
        </ControlTemplate>

        <!-- ══ Faceplate moulding: vertical grooves and key recesses ═══════ -->
        <Style x:Key="PanelGroove" TargetType="Border">
            <Setter Property="Width" Value="2"/>
            <Setter Property="Height" Value="194"/>
            <Setter Property="Canvas.Top" Value="8"/>
            <Setter Property="CornerRadius" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#D0000000" Offset="0"/>
                        <GradientStop Color="#D0000000" Offset="0.5"/>
                        <GradientStop Color="#26FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#26FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Recess" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource RecessBrush}"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <!-- Lit lower lip of a recess: same path, one pixel lower, drawn first. -->
        <Style x:Key="RecessLip" TargetType="Path" BasedOn="{StaticResource Recess}">
            <Setter Property="Stroke" Value="{StaticResource RecessLipBrush}"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="1.2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CenteredLabel" TargetType="TextBlock" BasedOn="{StaticResource PanelLabel}">
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- ══ Header: ON AIR lamp ══════════════════════════════════════════ -->
        <Style x:Key="OnAirLamp" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2,8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FF1B1011"/>
            <Setter Property="BorderBrush" Value="#FF3B2729"/>
            <Setter Property="TextElement.Foreground" Value="#FF6E4A4D"/>
            <Style.Triggers>
                <Trigger Property="fx:PanelFx.IsLit" Value="True">
                    <Setter Property="BorderBrush" Value="#FFFF7A7F"/>
                    <Setter Property="TextElement.Foreground" Value="White"/>
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFF0333B" Offset="0"/>
                                <GradientStop Color="#FFA50F17" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFFF2A33" BlurRadius="14" ShadowDepth="0" Opacity="0.9"/>
                        </Setter.Value>
                    </Setter>
                    <Trigger.EnterActions>
                        <BeginStoryboard x:Name="onAirPulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="24">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.72" Duration="0:0:0.6">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="onAirPulse"/>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ══ Header: ghost action button (Synchronize) ════════════════════ -->
        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#FFD3D5DC"/>
            <Setter Property="FontFamily" Value="{StaticResource PanelFont}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="9,0,11,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="scale"/>
                            </Grid.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.14"/>
                                        <VisualTransition From="Pressed" GeneratedDuration="0:0:0.3">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="edgeLit" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="edgeLit" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border CornerRadius="5" Background="#FF1F2027" BorderBrush="#FF3A3B45" BorderThickness="1"/>
                            <Border x:Name="edgeLit" CornerRadius="5" Opacity="0" BorderThickness="1" BorderBrush="#B3FF9200" Background="#14FF9200"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <!-- ════════════════════════════════════════════════════════════════════
         MAIN CHASSIS  1040 × 460  (margin leaves room for the cast shadow)
         ════════════════════════════════════════════════════════════════════ -->
        <Border x:Name="chassis" Width="1040" Height="460" Margin="12,8,12,18"
                CornerRadius="10" BorderThickness="1.5" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="chassisScale"/>
            </Border.RenderTransform>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF84858F" Offset="0"/>
                    <GradientStop Color="#FF34353D" Offset="0.12"/>
                    <GradientStop Color="#FF1A1B20" Offset="0.85"/>
                    <GradientStop Color="#FF0A0A0C" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <!-- Matte charcoal faceplate, as on the rig: no texture, only a faint top-to-bottom falloff. -->
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF3D3E44" Offset="0"/>
                    <GradientStop Color="#FF36373D" Offset="0.5"/>
                    <GradientStop Color="#FF303137" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <!-- Power-on: the panel settles in, then the LCD backlight strikes. -->
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
                            <DoubleAnimation Storyboard.TargetName="chassisScale" Storyboard.TargetProperty="ScaleX" From="0.975" To="1" Duration="0:0:0.55">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="chassisScale" Storyboard.TargetProperty="ScaleY" From="0.975" To="1" Duration="0:0:0.55">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="lcdLit" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.30" Value="0"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:0.36" Value="0.75"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:0.42" Value="0.2"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:0.50" Value="0.9"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:0.56" Value="0.55"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.85" Value="1">
                                    <EasingDoubleKeyFrame.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </EasingDoubleKeyFrame.EasingFunction>
                                </EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="176"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="34"/>
                    </Grid.RowDefinitions>

                <!-- Cast shadow: stacked translucent rings outside the chassis (no blur effect,
                     so animations inside the panel never re-render a full-size bitmap effect). -->
                <Border Grid.RowSpan="4" Margin="-3,-1,-3,-5" CornerRadius="13" BorderThickness="3,1,3,5" BorderBrush="#40000000" IsHitTestVisible="False"/>
                <Border Grid.RowSpan="4" Margin="-6,-2,-6,-9" CornerRadius="16" BorderThickness="3,1,3,4" BorderBrush="#26000000" IsHitTestVisible="False"/>
                <Border Grid.RowSpan="4" Margin="-10,-3,-10,-15" CornerRadius="20" BorderThickness="4,1,4,6" BorderBrush="#14000000" IsHitTestVisible="False"/>

                <!-- ══ TITLE BAR + MENU ═════════════════════════════════════════ -->
                <Border Grid.Row="0" CornerRadius="9,9,0,0" BorderThickness="0,0,0,1" BorderBrush="#FF09090B">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF1C1D23" Offset="0"/>
                            <GradientStop Color="#FF131418" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="6,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Menu Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <MenuItem Header="_File">
                                <MenuItem Header="_Exit" Click="MenuFileExit_Click"/>
                            </MenuItem>
                            <MenuItem Header="_Settings">
                                <MenuItem x:Name="menuMonitorAcc2" Header="Monitor _ACC2 (USB)" IsCheckable="True"
                                          Checked="MenuMonitorAcc2_Checked" Unchecked="MenuMonitorAcc2_Unchecked"/>
                                <Separator/>
                                <MenuItem Header="_Audio (USB / ACC2)…" Click="MenuSettingsAudio_Click"/>
                                <MenuItem Header="_Display color…" Click="MenuSettingsDisplayColor_Click"/>
                                <Separator/>
                                <MenuItem Header="_Open data folder…" Click="MenuSettingsOpenDataFolder_Click"/>
                            </MenuItem>
                            <MenuItem Header="_Help">
                                <MenuItem Header="_About…" Click="MenuHelpAbout_Click"/>
                            </MenuItem>
                        </Menu>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="TS-570D" Style="{StaticResource PanelLabel}" FontSize="12" Foreground="#FFECEDF1"/>
                            <Ellipse Width="4" Height="4" Margin="9,0" Fill="#FFFF9200" VerticalAlignment="Center"/>
                            <TextBlock Text="HF TRANSCEIVER  REMOTE" Style="{StaticResource PanelLabel}" FontSize="10" Foreground="#FF8E909A" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border x:Name="onAirLamp" Style="{StaticResource OnAirLamp}" Margin="0,0,10,0">
                                <TextBlock Text="ON AIR" FontFamily="{StaticResource PanelFont}" FontSize="9"/>
                            </Border>
                            <Button x:Name="btnSynchronize" Style="{StaticResource HeaderBtn}" Click="btnSynchronize_Click">
                                <Button.Triggers>
                                    <EventTrigger RoutedEvent="ButtonBase.Click">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="syncSpin" Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:0.7">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Button.Triggers>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="11" Height="11" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                                        <Viewbox.RenderTransform>
                                            <RotateTransform x:Name="syncSpin"/>
                                        </Viewbox.RenderTransform>
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M13.6,9.2 A5.8,5.8 0 1 1 12.1,3.9" Stroke="#FFFF9200" StrokeThickness="1.9"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Path Data="M13.4,0.9 L12.5,4.5 L8.9,3.7" Stroke="#FFFF9200" StrokeThickness="1.9"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="SYNCHRONIZE" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Bevel highlight under the title bar -->
                <Border Grid.Row="1" Height="1" VerticalAlignment="Top" Background="#16FFFFFF" IsHitTestVisible="False"/>

                <!-- ══ ROW 1 - LCD ═════════════════════════════════════════════ -->
                <Grid Grid.Row="1" Margin="5,4,5,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ══════════════════════════════════════════════════════════
                         Left column (rig: 40 x 14 stadium keys, PF round, POWER wide with
                         three dots; legends printed above; a ridge joins each key pair)
                         ══════════════════════════════════════════════════════════ -->
                    <Canvas Grid.Column="0">
                        <Canvas.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenteredLabel}">
                                <Setter Property="Width" Value="56"/>
                                <Setter Property="FontSize" Value="10.8"/>
                            </Style>
                            <Style x:Key="KeyRidge" TargetType="Border">
                                <Setter Property="Height" Value="4"/>
                                <Setter Property="CornerRadius" Value="1"/>
                                <Setter Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#55000000"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="IsHitTestVisible" Value="False"/>
                            </Style>
                        </Canvas.Resources>

                        <TextBlock Text="PF" Canvas.Left="-4" Canvas.Top="9.3"/>
                        <TextBlock Text="POWER" FontSize="12.6" Canvas.Left="48" Canvas.Top="8.3"/>
                        <Border Style="{StaticResource KeyRidge}" Width="18" Canvas.Left="34" Canvas.Top="33"/>
                        <Button x:Name="btnPf" Style="{StaticResource SideKeyBtn}" Width="22" Height="22" fx:PanelFx.CornerRadius="11"
                                Canvas.Left="13" Canvas.Top="24" Click="btnPf_Click"/>
                        <Button x:Name="btnPower" Style="{StaticResource SideKeyBtn}" Width="50" Height="20" fx:PanelFx.CornerRadius="10"
                                Canvas.Left="51" Canvas.Top="25" Click="btnPower_Click">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="2.6" Height="2.6" Fill="#FF8D909A" Margin="2.2,0"/>
                                <Ellipse Width="2.6" Height="2.6" Fill="#FF8D909A" Margin="2.2,0"/>
                                <Ellipse Width="2.6" Height="2.6" Fill="#FF8D909A" Margin="2.2,0"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="ATT" Canvas.Left="0" Canvas.Top="58.2"/>
                        <TextBlock Text="PRE-AMP" Canvas.Left="50" Canvas.Top="58.2"/>
                        <Border Style="{StaticResource KeyRidge}" Width="14" Canvas.Left="47" Canvas.Top="77.3"/>
                        <Button x:Name="btnAtt" Style="{StaticResource SideKeyBtn}" Canvas.Left="8" Canvas.Top="71.8" Click="btnAtt_Click"/>
                        <Button x:Name="btnPreAmp" Style="{StaticResource SideKeyBtn}" Canvas.Left="58" Canvas.Top="71.8" Click="btnPreAmp_Click"/>

                        <TextBlock Text="VOX" Canvas.Left="0" Canvas.Top="93.8"/>
                        <TextBlock Text="PROC" Canvas.Left="50" Canvas.Top="93.8"/>
                        <Border Style="{StaticResource KeyRidge}" Width="14" Canvas.Left="47" Canvas.Top="114.1"/>
                        <Button x:Name="btnVox" Style="{StaticResource SideKeyBtn}" Canvas.Left="8" Canvas.Top="108.6" Click="btnVox_Click"/>
                        <Button x:Name="btnProc" Style="{StaticResource SideKeyBtn}" Canvas.Left="58" Canvas.Top="108.6" Click="btnProc_Click"/>

                        <TextBlock Text="SEND" Canvas.Left="0" Canvas.Top="128.7"/>
                        <TextBlock Text="AT TUNE" Canvas.Left="50" Canvas.Top="128.7"/>
                        <Border Style="{StaticResource KeyRidge}" Width="14" Canvas.Left="47" Canvas.Top="148.5"/>
                        <Button x:Name="btnSend" Style="{StaticResource SideKeyBtn}" Canvas.Left="8" Canvas.Top="143" Click="btnSend_Click"/>
                        <Button x:Name="btnAtTune" Style="{StaticResource SideKeyBtn}" Canvas.Left="58" Canvas.Top="143" Click="btnAtTune_Click"
                                PreviewMouseLeftButtonDown="btnAtTune_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="btnAtTune_PreviewMouseLeftButtonUp"/>
                    </Canvas>

                    <!-- ╔══════════════════════════════════════════════╗
                     ║  AMBER LCD DISPLAY                          ║
                     ╚══════════════════════════════════════════════╝ -->
                    <Grid Grid.Column="1" Margin="2,0,2,0" HorizontalAlignment="Left" Width="775" Height="148">
                        <Border CornerRadius="6" Margin="0" BorderThickness="16,26,16,16">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop x:Name="gsLcdBezelTop" Color="#FF222210" Offset="0"/>
                                    <GradientStop x:Name="gsLcdBezelBottom" Color="#FF080804" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Background>#FF0B0B0E</Border.Background>
                            <Border.Effect>
                                <DropShadowEffect x:Name="fxLcdGlow" Color="#FFCC9900" BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <Border x:Name="lcdLit" Margin="0" CornerRadius="6" ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop x:Name="gsLcdFillTop" Color="#FFBC8A00" Offset="0"/>
                                        <GradientStop x:Name="gsLcdFillHigh" Color="#FFFFBA00" Offset="0.10"/>
                                        <GradientStop x:Name="gsLcdFillLow" Color="#FFFFBA00" Offset="0.90"/>
                                        <GradientStop x:Name="gsLcdFillBottom" Color="#FFBC8A00" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Meter block (left, fixed area) -->
                                    <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Top" Margin="4,1,0,0" HorizontalAlignment="Left">
                                        <Grid Width="200" Height="15" Margin="0,0,0,0" HorizontalAlignment="Left">
                                            <Canvas x:Name="smeterLegendCanvas" Width="200" Height="15">
                                                <TextBlock Text="1"  Width="14" TextAlignment="Center" FontFamily="pack://application:,,,/Resources/Fonts/helvetica-bold.ttf#Helvetica" FontSize="8.2" FontWeight="Bold" Foreground="#FF180800" Opacity="0.0784" Canvas.Left="26"   Canvas.Top="9" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                <TextBlock Text="3"  Width="14" TextAlignment="Center" FontFamily="pack://application:,,,/Resources/Fonts/helvetica-bold.ttf#Helvetica" FontSize="8.2" FontWeight="Bold" Foreground="#FF180800" Opacity="0.0784" Canvas.Left="44"  Canvas.Top="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Text="5"  Width="14" TextAlignment="Center" FontFamily="pack://application:,,,/Resources/Fonts/helvetica-bold.ttf#Helvetica" FontSize="8.2" FontWeight="Bold" Foreground="#FF180800" Opacity="0.0784" Canvas.Left="60"  Canvas.Top="9" HorizontalAlignment="Left" VerticalAlignment="Center"/>
