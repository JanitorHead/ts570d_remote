                        <Button x:Name="btnQmPlus" Content="+" Click="btnQmPlus_Click"/>
                        <Button x:Name="btnQmMinus" Content="-" Click="btnQmMinus_Click"/>
                    </StackPanel>

                    <!-- DOWN (618.9,45.6) / UP (679.6,31.8): Ø42 grey keys in a slanted twin recess, legends above-left -->
                    <TextBlock Text="DOWN" Style="{StaticResource CenteredLabel}" FontSize="10.9" Width="44" Canvas.Left="574.2" Canvas.Top="12.4"/>
                    <TextBlock Text="UP" Style="{StaticResource CenteredLabel}" FontSize="10.9" Width="30" Canvas.Left="639.8" Canvas.Top="4.2"/>
                    <Path Style="{StaticResource RecessLip}" StrokeThickness="49" Data="M 618.9,45.6 L 679.6,31.8"/>
                    <Path Style="{StaticResource Recess}" StrokeThickness="49" Data="M 618.9,45.6 L 679.6,31.8"/>
                    <Button x:Name="btnFreqDown" Style="{StaticResource LightRoundVfoBtn}" Width="42" Height="42" Canvas.Left="597.9" Canvas.Top="24.6" Click="btnFreqDown_Click">
                        <Grid Width="22" Height="22">
                            <Border Width="20" Height="4" CornerRadius="2" Background="#59FFFFFF" Margin="0,1.6,0,0"/>
                            <Border Width="20" Height="4" CornerRadius="2" Background="#FF5A5D64"/>
                        </Grid>
                    </Button>
                    <Button x:Name="btnFreqUp" Style="{StaticResource LightRoundVfoBtn}" Width="42" Height="42" Canvas.Left="658.6" Canvas.Top="10.8" Click="btnFreqUp_Click">
                        <Grid Width="22" Height="22">
                            <Grid Margin="0,1.6,0,0">
                                <Border Width="20" Height="4" CornerRadius="2" Background="#59FFFFFF"/>
                                <Border Width="4" Height="20" CornerRadius="2" Background="#59FFFFFF"/>
                            </Grid>
                            <Border Width="20" Height="4" CornerRadius="2" Background="#FF5A5D64"/>
                            <Border Width="4" Height="20" CornerRadius="2" Background="#FF5A5D64"/>
                        </Grid>
                    </Button>

                    <!-- QUICK MEMO: MR Ø24 (728.5,45.6) legend above, M.IN Ø24 (771.2,37.4) legend below -->
                    <Border Width="76" Height="11" Canvas.Left="711.5" Canvas.Top="7.7" CornerRadius="1" Background="#FFEDEEF1">
                        <TextBlock Text="QUICK MEMO" Style="{StaticResource CenteredLabel}" FontSize="10.4" Foreground="#FF1C1D22" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="MR" Style="{StaticResource CenteredLabel}" Width="30" Canvas.Left="713.5" Canvas.Top="20.8"/>
                    <Button x:Name="btnQmMR" Style="{StaticResource RoundVfoBtn}" Width="24" Height="24" Canvas.Left="716.5" Canvas.Top="33.6" Click="btnQmMR_Click"/>
                    <Button x:Name="btnQmMIn" Style="{StaticResource RoundVfoBtn}" Width="24" Height="24" Canvas.Left="759.2" Canvas.Top="25.4" Click="btnQmMIn_Click">
                        <Ellipse Width="3" Height="3" Fill="#FF1A1B1F" Stroke="#30FFFFFF" StrokeThickness="0.5"/>
                    </Button>
                    <TextBlock Text="M.IN" Style="{StaticResource CenteredLabel}" Width="36" Canvas.Left="753.2" Canvas.Top="53.9"/>

                    <!-- Function keys Ø36: centres x 618.9/669.2/719.5/769.8, y 100.8/146.2 -->
                    <Canvas>
                        <Canvas.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource LightRoundVfoBtn}">
                                <Setter Property="Width" Value="36"/>
                                <Setter Property="Height" Value="36"/>
                                <Setter Property="FontSize" Value="8.8"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </Canvas.Resources>
                        <Button x:Name="btnSplit" Content="SPLIT" Canvas.Left="600.9" Canvas.Top="82.8" Click="btnSplit_Click"/>
                        <Button x:Name="btnTfSet" Content="TF-SET" Canvas.Left="651.2" Canvas.Top="82.8" Click="btnTfSet_Click"
                                PreviewMouseLeftButtonDown="btnTfSet_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="btnTfSet_PreviewMouseLeftButtonUp"/>
                        <Button x:Name="btnAB" Content="A/B" Canvas.Left="701.5" Canvas.Top="82.8" Click="btnAB_Click"/>
                        <Button x:Name="btnRit" Content="RIT" Canvas.Left="751.8" Canvas.Top="82.8" Click="btnRit_Click"/>
                        <Button x:Name="btnMV" Content="M/V" Canvas.Left="600.9" Canvas.Top="128.2" Click="btnMV_Click"/>
                        <Button x:Name="btnAeqB" Content="A=B" Canvas.Left="651.2" Canvas.Top="128.2" Click="btnAeqB_Click"/>
                        <Button x:Name="btnCLS" Content="CLEAR" Canvas.Left="701.5" Canvas.Top="128.2" Click="btnCLS_Click"/>
                        <Button x:Name="btnXit" Content="XIT" Canvas.Left="751.8" Canvas.Top="128.2" Click="btnXit_Click"/>
                    </Canvas>

                    <!-- SCAN / M>VFO / M.IN: 46 x 15 pills on one moulded rail, y 181.4 -->
                    <Border Width="192" Height="20" Canvas.Left="598.7" Canvas.Top="171.4" CornerRadius="10" Background="{StaticResource RecessBrush}"
                            BorderThickness="0,0,0,1" BorderBrush="{StaticResource RecessLipBrush}" IsHitTestVisible="False"/>
                    <Button x:Name="btnScan" Content="SCAN" Style="{StaticResource PillBtn}" Width="46" Height="15" MinWidth="0" Padding="0" FontSize="10.8" Canvas.Left="602.1" Canvas.Top="173.9" Click="btnScan_Click"/>
                    <Button x:Name="btnMVfo" Content="M&gt;VFO" Style="{StaticResource PillBtn}" Width="46" Height="15" MinWidth="0" Padding="0" FontSize="10.8" Canvas.Left="671.7" Canvas.Top="173.9" Click="btnMVfo_Click"/>
                    <Button x:Name="btnMIn" Content="M.IN" Style="{StaticResource PillBtn}" Width="46" Height="15" MinWidth="0" Padding="0" FontSize="10.8" Canvas.Left="741.3" Canvas.Top="173.9" Click="btnMIn_Click"/>

                    <Border Style="{StaticResource PanelGroove}" Canvas.Left="803.3"/>

                    <!-- RIT/XIT Ø62 (856.3,46): legend in the gap between the arrows; MULTI/CH Ø62 (856.3,158.7) with detents -->
                    <TextBlock Text="RIT/XIT" Style="{StaticResource CenteredLabel}" FontSize="11.6" Width="60" Canvas.Left="826.3" Canvas.Top="-7.7"/>
                    <fx:KnobScale Kind="RitArrows" KnobRadius="31" ScaleRadius="44" Width="104" Height="104" Canvas.Left="804.3" Canvas.Top="-6"/>
                    <fx:RotaryKnob x:Name="knobRitXit" Width="62" Height="62" Canvas.Left="825.3" Canvas.Top="15" PointerBrush="{x:Null}"
                                   MouseWheel="RitXitKnob_MouseWheel"
                                   MouseLeftButtonDown="RitXitKnob_MouseLeftButtonDown" MouseMove="RitXitKnob_MouseMove" MouseLeftButtonUp="RitXitKnob_MouseLeftButtonUp"/>

                    <Grid Width="80" Canvas.Left="816.3" Canvas.Top="100">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Grid Width="38" Height="12.5">
                                <Path Data="M 0,0 L 38,0 L 34,12.5 L 0,12.5 Z" Fill="#FFF08A40"/>
                                <TextBlock Text="MULTI" Style="{StaticResource PanelLabel}" FontSize="9.5" Foreground="#FF1C1D22"
                                           Margin="0,0,4,0" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="CH" Style="{StaticResource PanelLabel}" FontSize="10" Margin="2.5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <fx:KnobScale Kind="Ticks" KnobRadius="31" ScaleRadius="36.5" Width="88" Height="88" Canvas.Left="812.3" Canvas.Top="114.7"/>
                    <fx:RotaryKnob x:Name="knobMultiCh" Width="62" Height="62" Canvas.Left="825.3" Canvas.Top="127.7" PointerBrush="{x:Null}"
                                   MouseWheel="MultiChKnob_MouseWheel"
                                   MouseLeftButtonDown="MultiChKnob_MouseLeftButtonDown" MouseMove="MultiChKnob_MouseMove" MouseLeftButtonUp="MultiChKnob_MouseLeftButtonUp"/>

                    <!-- AF —◎— RF (980.7,46) and IF SHIFT —◎— SQL (980.7,154.5): Ø64 / Ø46 concentric pots on 0–10 scales (±150°) -->
                    <Grid Width="120" Canvas.Left="920.7" Canvas.Top="-12.6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="AF" Style="{StaticResource PanelLabel}" FontSize="11" HorizontalAlignment="Right"/>
                        <ContentControl Grid.Column="1" Template="{StaticResource ConcentricGlyph}" Foreground="#FFF0F1F4"/>
                        <TextBlock Grid.Column="2" Text="RF" Style="{StaticResource PanelLabel}" FontSize="11" HorizontalAlignment="Left"/>
                    </Grid>
                    <fx:KnobScale Kind="Numbers" KnobRadius="32" ScaleRadius="37" Width="104" Height="104" Canvas.Left="928.7" Canvas.Top="-6"/>
                    <fx:RotaryKnob x:Name="knobRf" Width="64" Height="64" Canvas.Left="948.7" Canvas.Top="14"
                                   MouseWheel="AfRfOuterKnob_MouseWheel"
                                   MouseLeftButtonDown="AfRfOuterKnob_MouseLeftButtonDown" MouseMove="AfRfOuterKnob_MouseMove" MouseLeftButtonUp="AfRfOuterKnob_MouseLeftButtonUp"/>
                    <fx:RotaryKnob x:Name="knobAf" Kind="Inner" FluteDepth="0.035" Width="46" Height="46" Canvas.Left="957.7" Canvas.Top="23"
                                   MouseWheel="AfRfInnerKnob_MouseWheel"
                                   MouseLeftButtonDown="AfRfInnerKnob_MouseLeftButtonDown" MouseMove="AfRfInnerKnob_MouseMove" MouseLeftButtonUp="AfRfInnerKnob_MouseLeftButtonUp"/>

                    <Grid Width="150" Canvas.Left="905.7" Canvas.Top="97.6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="IF SHIFT" Style="{StaticResource PanelLabel}" FontSize="11" HorizontalAlignment="Right"/>
                        <ContentControl Grid.Column="1" Template="{StaticResource ConcentricGlyph}" Foreground="#FFF0F1F4"/>
                        <TextBlock Grid.Column="2" Text="SQL" Style="{StaticResource PanelLabel}" FontSize="11" HorizontalAlignment="Left"/>
                    </Grid>
                    <fx:KnobScale Kind="Numbers" KnobRadius="32" ScaleRadius="37" Width="104" Height="104" Canvas.Left="928.7" Canvas.Top="102.5"/>
                    <fx:RotaryKnob x:Name="knobIfShift" Width="64" Height="64" Canvas.Left="948.7" Canvas.Top="122.5"
                                   MouseWheel="IfSqlOuterKnob_MouseWheel"
                                   MouseLeftButtonDown="IfSqlOuterKnob_MouseLeftButtonDown" MouseMove="IfSqlOuterKnob_MouseMove" MouseLeftButtonUp="IfSqlOuterKnob_MouseLeftButtonUp"/>
                    <fx:RotaryKnob x:Name="knobSql" Kind="Inner" FluteDepth="0.035" Width="46" Height="46" Canvas.Left="957.7" Canvas.Top="131.5"
                                   MouseWheel="IfSqlInnerKnob_MouseWheel"
                                   MouseLeftButtonDown="IfSqlInnerKnob_MouseLeftButtonDown" MouseMove="IfSqlInnerKnob_MouseMove" MouseLeftButtonUp="IfSqlInnerKnob_MouseLeftButtonUp"/>
                </Canvas>

                <!-- ══ ROW 3 - STATUS BAR ══════════════════════════════════════ -->
                <Border Grid.Row="3" CornerRadius="0,0,9,9" BorderThickness="0,1,0,0" BorderBrush="#FF09090B" Padding="14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF17181D" Offset="0"/>
                            <GradientStop Color="#FF0F1013" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="txtStatusLeft" Text="Local simulation - ready"
                                   FontFamily="{StaticResource UiFont}" FontSize="9.5" Foreground="#FF6C6E78" VerticalAlignment="Center"/>
                        <Border Width="1" Height="12" Margin="14,0" Background="#FF2A2B32"/>
                        <TextBlock Text="CAT" FontFamily="{StaticResource PanelFont}" FontSize="8" Foreground="#FF8E909A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Grid VerticalAlignment="Center">
                            <Ellipse x:Name="ledCatGreen" Style="{StaticResource LedGreen}" Visibility="Hidden"/>
                            <Ellipse x:Name="ledCatAmber" Style="{StaticResource LedAmber}"/>
                        </Grid>
                        <Border Width="1" Height="12" Margin="14,0" Background="#FF2A2B32"/>
                        <TextBlock x:Name="txtStatusRight" Text="  ---"
                                   FontFamily="{StaticResource UiFont}" FontSize="9.5" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <SolidColorBrush x:Name="statusRightBrush" Color="#FF8E909A"/>
                            </TextBlock.Foreground>
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="statusRightShift"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ══ KNOB READOUT (floats above the knob being turned) ════════ -->
                <Canvas x:Name="hudLayer" Grid.RowSpan="4" IsHitTestVisible="False">
                    <Border x:Name="knobHud" Opacity="0" CornerRadius="6" Padding="9,4,9,6"
                            Background="#F00E0F13" BorderBrush="#FF3C3E48" BorderThickness="1">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="knobHudShift"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.65" Direction="270"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="txtHudLabel" Style="{StaticResource PanelLabelDim}" FontSize="7.6" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtHudValue" FontFamily="{StaticResource PanelFont}" FontWeight="Bold" FontSize="11.5"
                                           Foreground="#FFFFAA2E" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid Width="64" Height="3" Margin="0,4,0,0">
                                <Border CornerRadius="1.5" Background="#FF2A2B33"/>
                                <Border x:Name="hudBarFill" CornerRadius="1.5" Background="#FFFF9200" HorizontalAlignment="Left" Width="0"/>
                                <Border x:Name="hudBarCenter" Width="1" Background="#FF8E909A" HorizontalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Canvas>

            </Grid>
        </Border>
    </Viewbox>
</Window>
