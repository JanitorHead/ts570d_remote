<Window x:Class="TS570_Remote.DisplayColorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Display color"
        Height="580" Width="720"
        MinHeight="540" MinWidth="660"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        Style="{StaticResource DialogWindow}">

    <Window.Resources>
        <!-- Palette chip: colour swatch (from Tag) + name; lifts on hover. -->
        <Style x:Key="SwatchBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="scale"/>
                                    <TranslateTransform x:Name="lift"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.14"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Y" To="-1.5" Duration="0"/>
                                            <ColorAnimation Storyboard.TargetName="edge" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#FF6A6C78" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="edge" CornerRadius="6" Background="{StaticResource RaisedBrush}" BorderThickness="1">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#FF3A3B44"/>
                                </Border.BorderBrush>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="7,0,10,0" VerticalAlignment="Center">
                                <Border Width="16" Height="16" CornerRadius="4" BorderBrush="#40000000" BorderThickness="1"
                                        Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRoot}" Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Right" Text="Saved with your settings" Style="{StaticResource DialogHint}" VerticalAlignment="Bottom"/>
            <StackPanel>
                <TextBlock Text="LCD BACKLIGHT" Style="{StaticResource DialogEyebrow}"/>
                <TextBlock Text="Display color" Style="{StaticResource DialogTitle}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Picker card -->
            <Border Grid.Column="0" Style="{StaticResource DialogCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="7" BorderThickness="1" BorderBrush="#FF3A3B44" Background="Black"
                            Cursor="Cross" ClipToBounds="True"
                            MouseLeftButtonDown="SvPicker_MouseLeftButtonDown"
                            MouseMove="SvPicker_MouseMove"
                            MouseLeftButtonUp="SvPicker_MouseLeftButtonUp">
                        <Grid x:Name="svPickerGrid" SizeChanged="SvPickerGrid_SizeChanged">
                            <Rectangle RadiusX="6" RadiusY="6">
                                <Rectangle.Fill>
                                    <SolidColorBrush x:Name="svHueBrush" Color="#FFFF0000"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle RadiusX="6" RadiusY="6">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle RadiusX="6" RadiusY="6">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="#FF000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Grid x:Name="svMarker" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                                <Ellipse Stroke="#B0000000" StrokeThickness="3.5"/>
                                <Ellipse Stroke="White" StrokeThickness="2"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                        <TextBlock Text="HUE" Style="{StaticResource DialogEyebrow}" Foreground="{StaticResource InkDimBrush}" Margin="0,0,0,4"/>
                        <Slider x:Name="sliderHue" Minimum="0" Maximum="360" Foreground="Transparent" ValueChanged="SliderHue_ValueChanged">
                            <Slider.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#FFFF0000" Offset="0"/>
                                    <GradientStop Color="#FFFFFF00" Offset="0.1667"/>
                                    <GradientStop Color="#FF00FF00" Offset="0.3333"/>
                                    <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                                    <GradientStop Color="#FF0000FF" Offset="0.6667"/>
                                    <GradientStop Color="#FFFF00FF" Offset="0.8333"/>
                                    <GradientStop Color="#FFFF0000" Offset="1"/>
                                </LinearGradientBrush>
                            </Slider.Background>
                        </Slider>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource DialogHint}"
                               Text="Drag the field for saturation and brightness."/>
                </Grid>
            </Border>

            <!-- Values card -->
            <Border Grid.Column="2" Style="{StaticResource DialogCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Live preview: a slice of the LCD with the chosen backlight -->
                    <Border Grid.Row="0" Height="62" CornerRadius="7" BorderThickness="5" BorderBrush="#FF0C0C0E">
                        <Grid>
                            <Border CornerRadius="3">
                                <Border.Background>
                                    <SolidColorBrush x:Name="previewBrush" Color="#FFFF9200"/>
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#55000000" Offset="0"/>
                                        <GradientStop Color="#18FFFFFF" Offset="0.18"/>
                                        <GradientStop Color="#18FFFFFF" Offset="0.82"/>
                                        <GradientStop Color="#55000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="USB" Margin="9,0,0,6" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                       FontFamily="{StaticResource PanelFont}" FontSize="10" Foreground="#E4180800"/>
                            <TextBlock Text="7.074.00" Margin="0,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       FontFamily="pack://application:,,,/Resources/Fonts/DSEG7Classic-BoldItalic.ttf#DSEG7 Classic"
                                       FontSize="26" FontStyle="Italic" Foreground="#E4180800"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                        <TextBlock Text="HEX" Style="{StaticResource DialogEyebrow}" Foreground="{StaticResource InkDimBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtHex" FontFamily="{StaticResource MonoFont}" FontSize="13" TextChanged="TxtHex_TextChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <TextBlock Text="RGB" Style="{StaticResource DialogEyebrow}" Foreground="{StaticResource InkDimBrush}" Margin="0,0,0,3"/>
                        <Slider x:Name="sliderR" Minimum="0" Maximum="255" Foreground="#FFFF4D4D" ValueChanged="SliderRgb_ValueChanged"/>
                        <Slider x:Name="sliderG" Minimum="0" Maximum="255" Foreground="#FF3CD66B" ValueChanged="SliderRgb_ValueChanged" Margin="0,4,0,0"/>
                        <Slider x:Name="sliderB" Minimum="0" Maximum="255" Foreground="#FF4D8DFF" ValueChanged="SliderRgb_ValueChanged" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,14,0,0">
                        <TextBlock Text="PALETTES" Style="{StaticResource DialogEyebrow}" Foreground="{StaticResource InkDimBrush}" Margin="0,0,0,6"/>
                        <UniformGrid Columns="2">
                            <Button Content="Solaris" Style="{StaticResource SwatchBtn}" Tag="#FFBA00" Click="Preset_Click"/>
                            <Button Content="Aurora" Style="{StaticResource SwatchBtn}" Tag="#7DFF54" Click="Preset_Click"/>
                            <Button Content="Glacier" Style="{StaticResource SwatchBtn}" Tag="#C6F2FF" Click="Preset_Click"/>
                            <Button Content="Neptune" Style="{StaticResource SwatchBtn}" Tag="#6EC8FF" Click="Preset_Click"/>
                            <Button Content="Obsidian" Style="{StaticResource SwatchBtn}" Tag="#E6E6E0" Click="Preset_Click"/>
                            <Button Content="Nebula" Style="{StaticResource SwatchBtn}" Tag="#C28CFF" Click="Preset_Click"/>
                            <Button Content="Ruby Flux" Style="{StaticResource SwatchBtn}" Tag="#FF6A5A" Click="Preset_Click"/>
                            <Button Content="Cyber Lime" Style="{StaticResource SwatchBtn}" Tag="#B9FF2A" Click="Preset_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button DockPanel.Dock="Left" Content="Reset default" MinWidth="110" Click="BtnReset_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="92" Margin="0,0,10,0" IsCancel="True" Click="BtnCancel_Click"/>
                <Button Content="OK" MinWidth="92" IsDefault="True" Click="BtnOk_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
